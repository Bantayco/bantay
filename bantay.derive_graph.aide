spec: '1.0'
entities:
  derive_graph:
    display: page
    props:
      title: bantay derive-graph
      description: Bantay derives screen states and transitions from plain-English actions
  cujs:
    display: table
    parent: derive_graph
    props:
      title: Critical User Journeys
      _pattern: roster
      _group_by: area
      _sort_by: tier
      _sort_order: asc
  cuj_derive_graph:
    parent: cujs
    props:
      feature: Bantay derives screen states and transitions from plain-English actions in the aide
      tier: primary
      area: graph
  sc_derive_states:
    parent: cuj_derive_graph
    props:
      name: Derive screen states from actions
      given: Aide has actions described as what the user sees and does
      when: Developer runs bantay derive-graph
      then: Unique screen states (st_*) are generated by identifying distinct combinations of screen + component variants mentioned in actions
  sc_derive_transitions:
    parent: cuj_derive_graph
    props:
      name: Derive transitions from actions
      given: Aide has actions with trigger and outcome
      when: Developer runs bantay derive-graph
      then: Transitions (tr_*) are generated from each action, connecting the before-state to the after-state with the action as label and trigger component identified
  sc_derive_preview:
    parent: cuj_derive_graph
    props:
      name: Preview derived graph before writing
      given: Developer runs bantay derive-graph
      when: Derivation completes
      then: "Summary shown: N states, M transitions. Full list printed. Nothing written to aide until developer approves."
  sc_derive_diff:
    parent: cuj_derive_graph
    props:
      name: Show diff against existing graph
      given: Aide already has st_* and tr_* entities
      when: Developer runs bantay derive-graph
      then: Shows what would be added, removed, or changed compared to existing graph entities. Developer approves before applying.
  sc_derive_idempotent:
    parent: cuj_derive_graph
    props:
      name: Derivation is idempotent
      given: Graph was already derived and actions haven't changed
      when: Developer runs bantay derive-graph again
      then: No changes proposed
relationships: []
