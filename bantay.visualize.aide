spec: '1.0'
entities:
  visualize:
    display: page
    props:
      title: bantay visualize
      description: Developer renders the aide as an interactive screen map, state graph and walkthrough
  cujs:
    display: table
    parent: visualize
    props:
      title: Critical User Journeys
      _pattern: roster
      _group_by: area
      _sort_by: tier
      _sort_order: asc
  invariants:
    display: checklist
    parent: visualize
    props:
      title: Invariants
      _pattern: roster
      _group_by: category
  cuj_visualize_map:
    parent: cujs
    props:
      feature: Developer views the full screen map with draggable screens, transition arrows, and zoom/pan controls
      tier: primary
      area: visualize
  cuj_visualize_walkthrough:
    parent: cujs
    props:
      feature: Developer steps through a CUJ scenario by scenario with screen preview and given/when/then details
      tier: primary
      area: visualize
  cuj_visualize_generate:
    parent: cujs
    props:
      feature: Developer runs bantay visualize to generate an HTML screen map from any aide
      tier: primary
      area: visualize
  sc_visualize_with_screens:
    parent: cuj_visualize_generate
    props:
      name: Generate visualizer from aide with screen entities
      given: Aide file has screen and component entities
      when: Developer runs bantay visualize
      then: HTML file generated with screen wireframes composed from components and design tokens
  sc_visualize_without_screens:
    parent: cuj_visualize_generate
    props:
      name: Generate visualizer from aide without screen entities
      given: Aide file has CUJs and scenarios but no screen entities
      when: Developer runs bantay visualize
      then: Screens inferred from scenario given/then states, rendered as placeholder cards
  sc_visualize_output_file:
    parent: cuj_visualize_generate
    props:
      name: Output is a single self-contained HTML file
      given: Developer runs bantay visualize
      when: Generation completes
      then: Single HTML file with zero external dependencies written to project root
  sc_map_view_screens:
    parent: cuj_visualize_map
    props:
      name: View all screens on canvas
      given: Developer opens the visualizer
      when: Map mode loads
      then: All screens rendered as cards on a pannable canvas with transition arrows between them
  sc_map_drag_screen:
    parent: cuj_visualize_map
    props:
      name: Drag screen to reposition
      given: Developer viewing the map
      when: Developer drags a screen card
      then: Screen snaps to 20px grid, all connected arrows update live
  sc_map_zoom:
    parent: cuj_visualize_map
    props:
      name: Zoom in and out
      given: Developer viewing the map
      when: Developer uses scroll wheel or toolbar buttons
      then: Canvas zooms with percentage displayed, fit-all and reset buttons available
  sc_map_pan:
    parent: cuj_visualize_map
    props:
      name: Pan the canvas
      given: Developer viewing the map
      when: Developer clicks and drags on empty canvas
      then: Canvas pans, screens and arrows move together
  sc_map_arrows_component_level:
    parent: cuj_visualize_map
    props:
      name: Arrows connect to specific components
      given: A scenario transitions between screens via a specific component
      when: Map renders the transition
      then: Arrow starts from the specific component element, not the screen card edge
  sc_map_self_loops:
    parent: cuj_visualize_map
    props:
      name: Same-screen actions shown as self-loops
      given: Multiple scenarios stay on the same screen
      when: Map renders transitions
      then: Self-loop arc above the screen with action label
  sc_map_external_labels:
    parent: cuj_visualize_map
    props:
      name: Screen IDs and invariants shown as external labels
      given: Screen has an ID and linked invariants
      when: Map renders the screen
      then: Screen ID floats above the card, invariant IDs float below
  sc_walk_pick_cuj:
    parent: cuj_visualize_walkthrough
    props:
      name: Pick a CUJ to walk through
      given: Developer switches to walkthrough mode
      when: Developer selects a CUJ from the picker
      then: First scenario displayed with screen preview and given/when/then
  sc_walk_step_forward:
    parent: cuj_visualize_walkthrough
    props:
      name: Step forward through scenarios
      given: Developer viewing a scenario
      when: Developer clicks Next or presses arrow right
      then: Next scenario displayed, screen transitions if screen changes
  sc_walk_step_back:
    parent: cuj_visualize_walkthrough
    props:
      name: Step backward through scenarios
      given: Developer past the first scenario
      when: Developer clicks Back or presses arrow left
      then: Previous scenario displayed
  sc_walk_progress_dots:
    parent: cuj_visualize_walkthrough
    props:
      name: Progress dots show position in journey
      given: Developer walking through a CUJ
      when: Each step renders
      then: Dots show completed, current, and remaining steps
  sc_walk_screen_transition:
    parent: cuj_visualize_walkthrough
    props:
      name: Screen transitions animate on navigation change
      given: Current scenario is on screen A
      when: Next scenario is on screen B
      then: Screen preview animates from A to B with slide transition
  sc_walk_invariants_shown:
    parent: cuj_visualize_walkthrough
    props:
      name: Invariants displayed for each scenario
      given: Scenario has protected_by relationships
      when: Scenario step renders
      then: Linked invariants shown in the detail panel
  inv_visualize_self_contained:
    parent: invariants
    props:
      statement: Generated visualizer HTML must be a single file with zero external dependencies
      category: portability
      threat_signal: External CSS, JS, or font imports that fail offline
      test: tests/visualize-command.test.ts
  inv_visualize_aide_agnostic:
    parent: invariants
    props:
      statement: The visualizer engine must render any valid aide, not just spout or bantay
      category: integrity
      threat_signal: Hardcoded screen names, CUJ IDs, or product-specific content in the engine
      test: tests/visualize-command.test.ts
  sc_visualize_injects_tokens:
    parent: cuj_visualize_generate
    props:
      name: Visualizer injects CSS variables into generated HTML
      given: Aide has design token entities
      when: bantay visualize generates the HTML
      then: CSS variables from tokens are embedded in a style block so wireframes can reference them
  sc_visualize_renders_wireframes:
    parent: cuj_visualize_generate
    props:
      name: Visualizer renders wireframe HTML files inside component boxes
      given: wireframes/<comp_id>.html exists for a component
      when: bantay visualize renders a screen containing that component
      then: Wireframe HTML injected into the component box instead of description text
  sc_visualize_fallback:
    parent: cuj_visualize_generate
    props:
      name: Visualizer falls back to description when no wireframe file exists
      given: No wireframes/<comp_id>.html exists for a component
      when: bantay visualize renders a screen containing that component
      then: Component box shows comp name and description text (current behavior)
  sc_visualize_wireframe_variants:
    parent: cuj_visualize_generate
    props:
      name: Visualizer renders component wireframe variants based on scenario state
      given: "A scenario has component state props (e.g. comp_timer: idle)"
      when: bantay visualize renders the walkthrough step for that scenario
      then: Engine looks up wireframes/comp_timer--idle.html. If found, renders it. If not, falls back to wireframes/comp_timer.html
  sc_visualize_map_default_variants:
    parent: cuj_visualize_map
    props:
      name: Map view uses default wireframe variants
      given: Map view renders all screens
      when: No scenario context is available
      then: Map view uses the default wireframe (no variant suffix) for all components
  inv_wireframe_variant_fallback:
    parent: invariants
    props:
      statement: If a scenario references a component variant that has no wireframe file, the engine falls back to the default wireframe without error
      category: design_integrity
      threat_signal: Missing variant file causes blank component or render error
  sc_walk_scenario_list:
    parent: cuj_visualize_walkthrough
    props:
      name: Walkthrough shows all CUJs and scenarios as navigable list
      given: Developer opens walkthrough mode
      when: Walkthrough renders
      then: Left sidebar shows all CUJs grouped by area with scenarios listed under each. Current scenario highlighted. Clicking any scenario jumps to that step.
  sc_walk_direct_jump:
    parent: cuj_visualize_walkthrough
    props:
      name: Click any scenario to jump directly to it
      given: Developer viewing the scenario list
      when: Developer clicks a scenario in the sidebar
      then: Walkthrough jumps to that CUJ and scenario step, screen preview updates
  sc_map_sidebar_list:
    parent: cuj_visualize_map
    props:
      name: Persistent sidebar shared between map and walkthrough
      given: Developer opens the visualizer
      when: Any view renders
      then: Left sidebar with CUJ/scenario list is always visible and is the same DOM element in both map and walkthrough views. Selecting a scenario in the sidebar updates whichever view is active.
  sc_map_click_scenario_highlights:
    parent: cuj_visualize_map
    props:
      name: Clicking a scenario auto-selects its CUJ and highlights the card
      given: Developer clicks any scenario in the sidebar
      when: The scenario belongs to a CUJ
      then: The CUJ's storyboard renders automatically, the clicked scenario's card is highlighted and auto-panned to center
  sc_map_linear_layout:
    parent: cuj_visualize_map
    props:
      name: Storyboard shows unique screen states, not one card per scenario
      given: Developer selects a CUJ in the map sidebar
      when: Storyboard renders
      then: One card per unique (screen + component state) combination. Scenarios that share the same screen and state map to the same card. Cards ordered by first scenario appearance. Transition arrows only between cards with different states.
  sc_map_default_all_screens:
    parent: cuj_visualize_map
    props:
      name: Default view shows one screen per screen entity
      given: Developer opens map with no CUJ selected
      when: Map renders
      then: Deduplicated screens shown (one per screen entity) with all transition arrows
  sc_map_screen_min_height:
    parent: cuj_visualize_map
    props:
      name: Map screens use mobile portrait aspect ratio
      given: Map renders screen cards
      when: Screens are sized
      then: Each screen card has min-height 476px (iPhone portrait ratio at 220px width)
  sc_map_resizable_panels:
    parent: cuj_visualize_map
    props:
      name: Map sidebar width is adjustable
      given: Developer viewing the map
      when: Developer drags the divider between sidebar and canvas
      then: Sidebar width adjusts, canvas reflows, preference persists during session
  sc_walk_resizable_panels:
    parent: cuj_visualize_walkthrough
    props:
      name: Walkthrough panel widths are adjustable
      given: Developer viewing walkthrough
      when: Developer drags panel dividers
      then: Panel widths adjust, screen preview recenters
  sc_view_switch_preserves_selection:
    parent: cuj_visualize_map
    props:
      name: Switching views preserves selected scenario
      given: Developer has a scenario highlighted in map view
      when: Developer switches to walkthrough
      then: Same CUJ and scenario are selected in walkthrough, and vice versa
  sc_panels_full_height:
    parent: cuj_visualize_map
    props:
      name: Panels extend full window height
      given: Developer opens the visualizer
      when: Page renders
      then: Sidebar and canvas fill the full viewport height minus the mode bar
  sc_sidebar_independent_scroll:
    parent: cuj_visualize_map
    props:
      name: Sidebar scrolls independently from canvas
      given: Developer hovers over the sidebar
      when: Developer scrolls with mouse wheel
      then: Only the sidebar scrolls. Canvas does not zoom or pan.
  sc_mode_toggle_in_canvas:
    parent: cuj_visualize_map
    props:
      name: Map/Walkthrough toggle lives inside the canvas panel
      given: Developer opens the visualizer
      when: Page renders
      then: Mode toggle (Map/Walkthrough) is positioned inside the right canvas panel, not in a top-level bar. The sidebar is visually higher in hierarchy than the toggle.
  sc_map_labels_hidden_default:
    parent: cuj_visualize_map
    props:
      name: Screen and component IDs hidden by default
      given: Developer opens the visualizer
      when: Map or walkthrough renders
      then: Screen IDs (s-tag), component IDs (comp-label), and variant names are not visible
  sc_map_debug_overlay:
    parent: cuj_visualize_map
    props:
      name: Debug overlay toggle shows IDs and bounding boxes
      given: Developer wants to see screen and component IDs
      when: Developer clicks the debug overlay toggle button
      then: Semi-transparent overlay appears on all screens showing screen ID at top, dashed bounding box around each component with component ID and variant name. Overlay is slightly opaque so wireframe content is still visible underneath.
  sc_single_screen_instance:
    parent: cuj_visualize_generate
    props:
      name: Map and walkthrough share a single screen DOM element
      given: A scenario is selected
      when: The screen preview renders
      then: The same DOM element is used in both map and walkthrough views. Switching modes reparents the element, not recreates it.
  sc_map_keyboard_nav:
    parent: cuj_visualize_map
    props:
      name: Arrow keys navigate between scenarios within the current CUJ in map mode
      given: Developer has a scenario highlighted in map storyboard
      when: Developer presses left or right arrow key
      then: Highlight moves to the previous or next scenario within the same CUJ. Does not wrap around or jump to a different CUJ. No-ops at the first and last scenario.
  cuj_visualize_graph:
    parent: cujs
    props:
      feature: Visualizer renders a state-transition graph from screen states and transitions in the aide
      tier: primary
      area: visualize
  sc_graph_nodes_from_states:
    parent: cuj_visualize_graph
    props:
      name: Graph nodes from screen state entities
      given: Aide has st_* entities with screen and component variant props
      when: bantay visualize generates the graph view
      then: Each st_* entity renders as a node showing the screen wireframe with component variants applied
  sc_graph_edges_from_transitions:
    parent: cuj_visualize_graph
    props:
      name: Graph edges from transition entities
      given: Aide has tr_* entities with from, to, and action props
      when: bantay visualize generates the graph view
      then: Each tr_* entity renders as a directed edge between its from and to screen states with the action as a label
  sc_graph_highlight_scenario_path:
    parent: cuj_visualize_graph
    props:
      name: Selecting a scenario highlights its path through the graph
      given: A scenario has a path prop listing transition IDs
      when: Developer clicks the scenario in the sidebar
      then: The transitions in the path and their connected screen states are highlighted. All other nodes dim to 0.2 opacity.
  sc_storyboard_from_path:
    parent: cuj_visualize_graph
    props:
      name: Storyboard renders scenario path as horizontal strip
      given: A scenario has a path prop listing transition IDs
      when: Developer views the storyboard for that scenario
      then: Screen states are rendered left to right in path order with transition arrows between them. Each screen shows the wireframe with variant state.
  sc_graph_trigger_prop:
    parent: cuj_visualize_graph
    props:
      name: Transition trigger identifies which UI element is tapped
      given: A transition has a trigger prop referencing a component or action
      when: The transition edge is rendered
      then: The label on the edge shows the action text. In debug mode the trigger element is highlighted on the source screen.
  sc_graph_default_view:
    parent: cuj_visualize_graph
    props:
      name: Graph is the default view when the aide declares states and transitions
      given: Aide contains st_* and tr_* entities
      when: Developer opens the generated visualization
      then:
      - State-transition graph is shown first
      - Screen map remains available as a secondary view
  sc_visualize_exclude_containers:
    parent: cuj_visualize_generate
    props:
      name: Section containers are excluded from the screen map
      given: Aide has section entities (cujs, invariants, constraints, foundations, wisdom) alongside screens
      when: Developer runs bantay visualize
      then:
      - Only screen_* and comp_* entities render as nodes
      - Section containers never appear as screens
relationships:
- from: cuj_visualize_map
  to: cuj_visualize_generate
  type: depends_on
  cardinality: many_to_many
- from: cuj_visualize_walkthrough
  to: cuj_visualize_generate
  type: depends_on
  cardinality: many_to_many
- from: sc_visualize_output_file
  to: inv_visualize_self_contained
  type: protected_by
  cardinality: many_to_many
- from: sc_visualize_with_screens
  to: inv_visualize_aide_agnostic
  type: protected_by
  cardinality: many_to_many
- from: sc_visualize_without_screens
  to: inv_visualize_aide_agnostic
  type: protected_by
  cardinality: many_to_many
- from: sc_visualize_wireframe_variants
  to: inv_wireframe_variant_fallback
  type: protected_by
  cardinality: many_to_many
- from: cuj_visualize_graph
  to: cuj_visualize_generate
  type: depends_on
  cardinality: many_to_many
