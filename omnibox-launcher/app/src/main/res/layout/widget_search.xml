<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_bar"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_gravity="center"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="8dp">

    <ImageView
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_search"
        android:tint="@color/widget_fg_color" />

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />

    <ImageView
        android:id="@+id/widget_song"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/song_search"
        android:padding="12dp"
        android:src="@drawable/ic_music"
        android:tint="@color/widget_fg_color" />

    <ImageView
        android:id="@+id/widget_mic"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/voice_search"
        android:padding="12dp"
        android:src="@drawable/ic_mic"
        android:tint="@color/widget_fg_color" />

    <ImageView
        android:id="@+id/widget_lens"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/lens_search"
        android:padding="12dp"
        android:src="@drawable/ic_lens"
        android:tint="@color/widget_fg_color" />
</LinearLayout>
